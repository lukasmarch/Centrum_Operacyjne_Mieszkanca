      "parameters": {
        "jsCode": "\nconst s = $input.first().json;\nconst c = s.content || {};\nlet headline = (c.headline || s.headline || '').replace(/AWARIA:\\s*/, '').trim();\nlet text = (c.highlights || '').replace(/\\*\\*/g, '').trim();\nconst events = (c.upcoming_events || []).slice(0, 3).map(e => '📅 ' + e);\nlet post = headline + '\\n\\n' + text;\nif (events.length) post += '\\n\\nNadchodzące wydarzenia:\\n' + events.join('\\n');\npost += '\\n\\n👉 Więcej na https://rybnolive.pl\\n#Rybno #GminaRybno #PowiatDziałdowski';\nreturn [{ json: { post, date: c.date || s.date, headline } }];\n"
