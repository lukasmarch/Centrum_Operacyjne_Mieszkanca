rybnolive.pl {
    root * /srv/frontend
    file_server

    # Sitemapę generuje backend (lista tras + lastmod z bazy). Zwykłe
    # `try_files {path} /index.html` przepisałoby /sitemap.xml na SPA-fallback
    # ZANIM reverse_proxy zdąży dopasować ścieżkę (kolejność dyrektyw: rewrite
    # przed proxy) — stąd rewrite z jawnym wyjątkiem zamiast try_files.
    #
    # `{path}/index.html` PRZED ogólnym fallbackiem: `npm run build` zapisuje dla
    # każdej trasy osobny HTML z własnym title/description/canonical
    # (scripts/prerender-meta.mjs). Bez tej linii robot bez JS dostaje na /cennik
    # nagłówek strony głównej, bo aplikacja ustawia meta dopiero po starcie.
    @spa_fallback {
        not path /sitemap.xml
        not file {
            try_files {path} {path}/index.html
        }
    }
    rewrite @spa_fallback /index.html

    @prerendered {
        not path /sitemap.xml
        file {
            try_files {path}/index.html
        }
    }
    rewrite @prerendered {path}/index.html

    reverse_proxy /sitemap.xml backend:8000

    encode gzip

    # HSTS i Permissions-Policy od 11.10.2026 (audyt, F-030). HSTS bez
    # `includeSubDomains`: nie każda subdomena musi stać za Caddy. Uprawnienia
    # przeglądarki tylko te, których strona używa — mikrofon (pytanie głosem),
    # lokalizacja i aparat (Zgłoszenia 24); resztę wyłączamy.
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000"
        Permissions-Policy "microphone=(self), geolocation=(self), camera=(self), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()"

        # Content-Security-Policy w trybie RAPORTOWANIA (audyt 11.10.2026, E8): przeglądarka niczego
        # nie blokuje, tylko zgłasza do /api/csp-report (tabela csp_violations, odczyt:
        # `python -m scripts.csp_report`). Polityka sprawdzona 13.10 headless Chrome na 19 trasach
        # produkcyjnych — 0 naruszeń. Przełączenie na blokowanie (`Content-Security-Policy`) dopiero po
        # ~2 tygodniach raportów. Źródła:
        #   style-src 'unsafe-inline' — inline <style> w index.html i atrybuty style= z Reacta
        #   fonts.googleapis.com / fonts.gstatic.com — Outfit
        #   img-src https: — obrazy artykułów z wielu portali (gazetaolsztynska.pl, gminarybno.pl,
        #     radioolsztyn.pl, fbcdn.net) i kafelki map (Carto, OpenStreetMap), ikony pogody
        #   connect-src api.rybnolive.pl + nominatim.openstreetmap.org (wyszukiwanie adresu w Zgłoszeniach)
        #   blob: — podgląd zdjęć przed wysłaniem i zdjęcia pism w panelu redakcji
        # Dwa mechanizmy raportowania, bo przeglądarki różnią się: report-uri (starszy, Firefox/Safari)
        # i report-to + Reporting-Endpoints (Chrome). Backtick: wartość zawiera cudzysłowy.
        Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://api.rybnolive.pl https://nominatim.openstreetmap.org; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri https://api.rybnolive.pl/api/csp-report; report-to csp"
        Reporting-Endpoints `csp="https://api.rybnolive.pl/api/csp-report"`
    }

    # Cache-Control celuje w konkretne ścieżki, a NIE globalnie. Dwie pułapki,
    # obie wykryte 29.07.2026 w świeżym logu dostępu:
    #  1) `Cache-Control` w bloku `header {}` bez matchera wygrywał z późniejszym
    #     `header @html` — dyrektywa zadeklarowana wyżej owija tę niżej, więc na
    #     WriteHeader nadpisywała ją. index.html i sw.js leciały z `immutable`;
    #  2) nazwany matcher musi mieć JEDNĄ linię `path` — dwie linie łączą się
    #     przez AND, a żadna ścieżka nie jest naraz `/` i `/sw.js`.
    # Skutek obu razem: kto raz wszedł na stronę, dostawał ten sam bundle przez
    # rok i żaden deploy do niego nie docierał — także poprawki kampanijne.
    @immutable path /assets/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    # Klatki animacji hero i ikony: stałe nazwy plików, więc bez `immutable` —
    # tydzień wystarcza, a podmiana assetu dojdzie do ludzi bez zmiany nazwy.
    @statics path /videos/* /agents/* *.png *.jpg
    header @statics Cache-Control "public, max-age=604800"

    # Reguła odwrócona: „wszystko, co NIE jest statycznym zasobem, ma się nie
    # cache'ować". Wcześniej była to lista ścieżek (`/ *.html …`) i przy dodaniu
    # prerenderowanych podstron przestała wystarczać: matcher widzi adres SPRZED
    # przepisania, więc `/cennik` nie pasuje ani do `/`, ani do `*.html`
    # i wychodził BEZ nagłówka — a wtedy przeglądarka cache'uje heurystycznie
    # i powracający dostaje HTML wskazujący nieistniejący już bundle.
    @nocache {
        not path /assets/* /videos/* /agents/*
        not path *.png *.jpg *.jpeg *.svg *.webp *.ico *.woff2
    }
    header @nocache Cache-Control "no-cache"

    # Pomiar wejść. Do 29.07.2026 nie istniał ŻADEN zapis ruchu — ani tu, ani
    # w uvicornie — więc pytanie „ile osób przyszło z kampanii" nie miało źródła
    # odpowiedzi. Log daje: liczbę wejść, unikalne IP, `Referer` (odróżnia
    # l.facebook.com od instagram.com) i parametry kampanijne (?alerty, utm_*).
    #
    # Świadomie zamiast GA4: zero ciasteczek, więc zero banera zgody, dane nie
    # wychodzą z serwera. IP jest daną osobową — stąd krótka retencja (7 dni,
    # tyle trwa ocena jednej fali kampanii). Raport: scripts/traffic_report.py
    log {
        output file /data/access.log {
            roll_size 20MiB
            roll_keep 4
            roll_keep_for 168h
        }
        format json
    }
}

www.rybnolive.pl {
    redir https://rybnolive.pl{uri} permanent
}

api.rybnolive.pl {
    reverse_proxy backend:8000 {
        flush_interval -1
    }
    handle_path /uploads/* {
        file_server
        root * /app/uploads
    }
    # HSTS i Permissions-Policy od 11.10.2026 (audyt, F-030). HSTS bez
    # `includeSubDomains`: nie każda subdomena musi stać za Caddy. Uprawnienia
    # przeglądarki tylko te, których strona używa — mikrofon (pytanie głosem),
    # lokalizacja i aparat (Zgłoszenia 24); resztę wyłączamy.
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000"
        Permissions-Policy "microphone=(self), geolocation=(self), camera=(self), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()"
    }

    # Log API — osobny plik, bo dopiero on pokazuje, co się dzieje PO wejściu.
    # Log strony (wyżej) widzi jeden GET i nic więcej: aplikacja to SPA, więc
    # przejście do Aktualności, otwarcie czatu czy przewinięcie feedu nie
    # generuje żadnego żądania do rybnolive.pl. 05.08.2026 skończyło się to
    # wnioskiem wyssanym z palca („ludzie wchodzą i nic nie robią”), którego
    # nie dało się ani potwierdzić, ani obalić — bo host api.rybnolive.pl nie
    # miał ANI JEDNEGO wpisu w logu. Teraz lejek jest mierzalny.
    #
    # Osobny plik, nie wspólny z access.log: jedno wejście to kilkanaście
    # wywołań API, więc przy wspólnej rotacji ruch API wypchnąłby historię
    # wejść na długo przed upływem 7 dni.
    #
    # Filtr `query` wycina tokeny z adresu. Log jest już zbiorem danych
    # osobowych (IP), ale token wypisu z newslettera działa jak klucz do konta
    # — kto ma plik, mógłby wypisać cudzy adres. Zdejmujemy go na wejściu,
    # zamiast liczyć na to, że nikt nie zajrzy. Nagłówki Authorization
    # i Cookie Caddy redaguje sam.
    log {
        output file /data/api-access.log {
            roll_size 20MiB
            roll_keep 4
            roll_keep_for 168h
        }
        format filter {
            wrap json
            fields {
                request>uri query {
                    delete token
                    delete access_token
                }
            }
        }
    }
}
